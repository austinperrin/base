#!/usr/bin/env bash
# Git commit-msg hook: validate the subject against the repository Git standard.
set -euo pipefail

if [[ $# -ne 1 || ! -r "$1" ]]; then
  echo "Error: provide a readable commit message file." >&2
  exit 1
fi

subject=$(head -n 1 "$1")
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^()[:space:]]+\))?!?: [^[:space:]].*$'
if [[ ! "$subject" =~ $pattern ]]; then
  echo "Commit rejected: use <type>(<optional scope>): <description>." >&2
  echo "Example: docs: clarify repository setup" >&2
  echo "See docs/standards/git-workflow.md for allowed types and breaking changes." >&2
  exit 1
fi
