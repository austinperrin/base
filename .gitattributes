# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.c text
*.cpp text
*.cs text
*.css text
*.go text
*.html text
*.java text
*.js text
*.json text
*.jsx text
*.md text
*.py text
*.rb text
*.rs text
*.sh text eol=lf
*.sql text
*.ts text
*.tsx text
*.xml text
*.yaml text
*.yml text

